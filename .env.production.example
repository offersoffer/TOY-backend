# =============================================================================
# Production configuration template  (Database §5, §13)
# =============================================================================
# Copy to `.env.production` on the production host, or - better - inject these
# as real environment variables from a secrets manager and keep no file at all.
#
# `.env.production` is gitignored. This template is not: it must never hold a
# real value. Every `<...>` below is a placeholder.
#
# Production does NOT read the generic `.env`. That is deliberate (§13): a
# production process must never silently inherit a developer's database or
# their test payment keys.

NODE_ENV=production
PORT=3000

# ---------------------------------------------------------------------------
# Database (§4, §10, §11, §15)
# ---------------------------------------------------------------------------
# DB_NAME is what the app connects to. PRODUCTION_DB_NAME is what it *expects*.
# They must match, or startup is refused - that is the whole point of having
# both, and it is what catches a production deploy aimed at staging.
DB_HOST=<production-db-host>
DB_PORT=3306
DB_NAME=offers_production
PRODUCTION_DB_NAME=offers_production

# Optional allow-list of hosts production may connect to (§14). Comma
# separated. Leave blank if the host is not predictable (service DNS, socket).
PRODUCTION_DB_HOSTS=

# A dedicated least-privilege user - never root (§10), and never the
# development password (§11).
DB_USER=offers_app_prod
DB_PASSWORD=<secret>
DB_CONNECTION_LIMIT=20

# ---------------------------------------------------------------------------
# Seed data (§6, §29)
# ---------------------------------------------------------------------------
# Production is seeded with system data only: roles, permissions, plans, the
# feature catalogue and categories. Never demo shops, offers or claims.
SEED_DEMO_DATA=false

# The first administrator. Both must differ from the shipped defaults or the
# seed refuses to run - the defaults are in the README and identical on every
# install. Generate the password with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
SEED_SUPERADMIN_EMAIL=<a-real-admin-address>
SEED_SUPERADMIN_PASSWORD=<secret>

# ---------------------------------------------------------------------------
# Secrets (§12)
# ---------------------------------------------------------------------------
# Distinct from every other environment. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=<secret>
JWT_REFRESH_SECRET=<secret>
CLAIM_QR_SECRET=<secret>

# ---------------------------------------------------------------------------
# Razorpay - LIVE credentials (§17, §31)
# ---------------------------------------------------------------------------
# Live keys belong only here. Staging uses test mode; connecting staging to
# live credentials means real money moves during QA.
RAZORPAY_KEY_ID=<rzp_live_...>
RAZORPAY_KEY_SECRET=<secret>
RAZORPAY_WEBHOOK_SECRET=<secret>
RAZORPAY_PLAN_BUSINESS=<plan_...>
RAZORPAY_PLAN_PREMIUM=<plan_...>

# Printed on real invoices. Confirm against current GST before launch.
BILLING_TAX_PERCENT=18

# ---------------------------------------------------------------------------
# Origins, storage and integrations (§18, §19)
# ---------------------------------------------------------------------------
# The web app and the API share one origin: nginx serves the Angular build and
# forwards /api to this process. That mirrors `proxy.conf.json` in the frontend
# repo, so production behaves the way development does. Images are the one
# exception: they come from the CDN at STORAGE_PUBLIC_URL below.
CORS_ORIGINS=https://offersoffer.in,https://www.offersoffer.in

# Absolute base of this API. Image URLs are built from it only with the local
# driver; in production they use STORAGE_PUBLIC_URL instead.
PUBLIC_API_URL=https://offersoffer.in
APP_URL=https://offersoffer.in

# Same-origin, so the refresh cookie does not need to be a cross-site one.
# `lax` is the stronger setting: the browser refuses to attach it to requests
# initiated by another site at all, which removes the CSRF exposure that
# `none` creates rather than merely defending against it.
#
# Change both to `none` / `true` only if the API ever moves to its own
# subdomain - a cross-site cookie is rejected by browsers unless it is Secure.
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=true

# Must match `expo.scheme` in the mobile app, or notification deep links open
# the app but not the screen they name.
MOBILE_APP_SCHEME=offersapp

# Images live in S3 and are served by CloudFront - never on this server's disk,
# which would die with it. Startup is refused unless the driver is s3, the
# bucket is set and does not look like staging's (§19), and the public URL is
# https. No AWS keys: the SDK uses the EC2 instance's IAM role.
STORAGE_DRIVER=s3
S3_BUCKET=<production-bucket-name>
S3_REGION=ap-south-1
# Where images are served from. Every stored image URL is built from it, so set
# it before the first upload and do not change it afterwards.
STORAGE_PUBLIC_URL=https://media.offersoffer.in
MAX_UPLOAD_MB=5

# Production notification credentials, never the development project (§18).
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=<secret>

SMTP_HOST=<production-smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<production-smtp-user>
SMTP_PASSWORD=<secret>
MAIL_FROM=OffersOffer <no-reply@offersoffer.in>

# Address -> coordinates for shop branches. The public Nominatim instance
# allows roughly one request a second and may block sustained use; point this
# at a self-hosted or commercial endpoint for production volume. The
# User-Agent is required by Nominatim's usage policy - left unset it advertises
# whatever APP_URL is.
GEOCODING_API_BASE=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=OffersOffer/1.0 (https://offersoffer.in)

AI_SERVICE_ENABLED=true
AI_SERVICE_URL=<production-ai-service-url>
AI_SERVICE_TOKEN=<secret>

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=false
APP_VERSION=
DEPLOYMENT_ID=

# ---- Support desk ----
# Published on the Support, Contact and Privacy pages, and served to the apps
# from GET /api/support/contact - so changing a number here changes it in the
# web and mobile clients without a rebuild.
SUPPORT_EMAIL=offersoffersupport@gmail.com
SUPPORT_PHONES="+91 7540043503,+91 7904795700"
# Where a new ticket is announced. Defaults to SUPPORT_EMAIL; point it at a
# shared mailbox or a helpdesk address when one exists. Leave SMTP unconfigured
# and the announcement goes to mail-outbox/ instead - the ticket is still saved.
SUPPORT_INBOX=offersoffersupport@gmail.com
