# ---- Server ----
NODE_ENV=development
PORT=3000
API_PREFIX=/api
# Comma separated list of allowed browser origins.
# In development any localhost/127.0.0.1 port is accepted regardless of this
# list, because the Angular dev server does not always get the port it asks for.
# In production this list is the only thing honoured.
CORS_ORIGINS=http://localhost:4200

# Public base URL of this API (used to build absolute image URLs)
PUBLIC_API_URL=http://localhost:3000
# Public base URL of the Angular app (used in emails + share links)
APP_URL=http://localhost:4200

# ---- Mobile push (Push §37) -------------------------------------------------
# The scheme the Expo app registers (app.json -> expo.scheme). Every
# notification stores a deep link built from this.
MOBILE_APP_SCHEME=offersapp
# Set PUSH_ENABLED=false to keep the in-app notification feed working while
# skipping device delivery entirely - useful on a machine with no outbound
# network access.
PUSH_ENABLED=true
PUSH_TRANSPORT=expo
# Only needed once "push security" is enabled for the Expo project; the Expo
# push relay accepts unauthenticated sends by default.
EXPO_ACCESS_TOKEN=

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=offers_app
DB_CONNECTION_LIMIT=10

# ---- Auth ----
# Use long random strings in any non-local environment
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ---- Claim codes ----
# Signs the QR payload on a claim code.
#
# Optional in development: left blank, the key is derived from
# JWT_ACCESS_SECRET, which keeps a fresh checkout working with no setup.
#
# SET IT EXPLICITLY IN PRODUCTION. Without it the QR key is tied to the access
# secret, so rotating that secret silently invalidates every QR already in a
# customer's pocket - the printed code still works, the scan stops. Setting
# this decouples the two, and it costs nothing to do before any codes are live.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Minimum 32 characters; the app refuses to start with anything shorter,
# because a short key is a weak HMAC rather than an obvious mistake.
CLAIM_QR_SECRET=

# ---- Email (nodemailer) ----
# Verification and password-reset links are emailed from here.
#
# Leave SMTP_HOST empty and NOTHING IS SENT: messages are written to
# ./mail-outbox/*.html and the link is printed to the server log, so you can
# still complete signup locally. The API reports delivered:false in that case.
#
# Gmail (needs a 16-character App Password, not your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop
#
# Mailtrap / Ethereal, for testing without real delivery:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_SECURE=false
# SMTP_HOST is the mail *server*, never an email address.
# SMTP_USER must be the same mailbox as the address inside MAIL_FROM, and
# MAIL_FROM must contain an address in angle brackets - a bare display name
# is not a valid sender.
SMTP_HOST=smtp.gmail.com
# 465 + SMTP_SECURE=true (implicit TLS), or 587 + SMTP_SECURE=false (STARTTLS).
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=offersoffersupport@gmail.com
SMTP_PASSWORD=
MAIL_FROM="OffersOffer <offersoffersupport@gmail.com>"

# ---- Support desk ----
# Published on the Support, Contact and Privacy pages, and served to the apps
# from GET /api/support/contact - so changing a number here changes it in the
# web and mobile clients without a rebuild.
SUPPORT_EMAIL=offersoffersupport@gmail.com
SUPPORT_PHONES="+91 7540043503,+91 7904795700"
# Where a new ticket is announced. Defaults to SUPPORT_EMAIL; point it at a
# shared mailbox or a helpdesk address when one exists. Leave SMTP unconfigured
# and the announcement goes to mail-outbox/ instead - the ticket is still saved.
SUPPORT_INBOX=offersoffersupport@gmail.com

# ---- Uploads ----
# local | s3. Development uses local disk; production must use s3.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Only read when STORAGE_DRIVER=s3. No AWS keys here: the SDK finds credentials
# itself (the server's IAM role on EC2, ~/.aws or AWS_PROFILE on a laptop).
S3_BUCKET=
S3_REGION=ap-south-1
# The CDN in front of the bucket; every stored image URL is built from it.
STORAGE_PUBLIC_URL=
# Only for an S3-compatible store such as MinIO. Leave empty for AWS.
S3_ENDPOINT=

# ---- Discovery (V2) ----
# Default "Near me" radius, the Ending Soon window, and the threshold below
# which an offer is shown as urgent.
DISCOVERY_DEFAULT_RADIUS_KM=10
DISCOVERY_ENDING_SOON_HOURS=72
DISCOVERY_URGENT_HOURS=6

# ---- Geocoding (§17) ----
# Branch addresses are turned into coordinates on save, so nobody has to type a
# latitude and longitude by hand. The default provider is OpenStreetMap's
# Nominatim: no API key, but its usage policy wants an identifying User-Agent
# and at most one request a second. Point GEOCODING_API_BASE at a self-hosted
# instance or a commercial /search endpoint to lift that limit.
#
# GEOCODING_ENABLED=false skips the lookup; branches then save with only the
# coordinates the caller supplied, which is what a machine with no outbound
# network access wants.
GEOCODING_ENABLED=true
GEOCODING_PROVIDER=nominatim
GEOCODING_API_BASE=https://nominatim.openstreetmap.org
# Defaults to "OffersOffer/1.0 (<APP_URL>)" when left empty.
GEOCODING_USER_AGENT=
GEOCODING_TIMEOUT_MS=5000
GEOCODING_BUDGET_MS=12000
GEOCODING_MAX_QUERIES=4
GEOCODING_MIN_INTERVAL_MS=1100
GEOCODING_MAX_QUEUE_DEPTH=8
GEOCODING_CACHE_SIZE=500

# ---- Payments: Razorpay ----
# Leave RAZORPAY_KEY_ID empty and checkout answers 503 PAYMENTS_NOT_CONFIGURED
# rather than failing deep inside an HTTP call. The plan catalogue reports
# payment.enabled=false so the UI can say so up front.
#
# Test credentials come from the Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks. Subscribe the endpoint
#   POST {PUBLIC_API_URL}/api/payments/razorpay/webhook
# to: payment.authorized, payment.captured, payment.failed,
#     subscription.authenticated, subscription.activated, subscription.charged,
#     subscription.pending, subscription.halted, subscription.paused,
#     subscription.resumed, subscription.cancelled, subscription.completed,
#     refund.created, refund.processed
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com/v1

# Razorpay Plan ids (Dashboard > Subscriptions > Plans), one per paid plan.
# Recurring billing and UPI AutoPay are created against these; without them the
# corresponding plan cannot be purchased.
#   Business = Rs 999 / month, Premium = Rs 2,500 / month
RAZORPAY_PLAN_BUSINESS=
RAZORPAY_PLAN_PREMIUM=
# Billing cycles a mandate is authorised for before it must be renewed.
RAZORPAY_TOTAL_COUNT=120

# ---- Billing behaviour ----
# Days a failed renewal keeps its features before the plan drops to Free.
# Merchant data is never deleted, only the plan changes.
BILLING_GRACE_DAYS=5
# Tax already included in the plan price; invoices back-compute the split.
BILLING_TAX_PERCENT=18
BILLING_INVOICE_PREFIX=INV

# ---- Refresh cookie (web persistent login) ----
# The refresh token is set as an httpOnly cookie for the Angular app.
# Same-site API + SPA:      SAMESITE=lax
# API on a different site:  SAMESITE=none  (browsers then require SECURE=true)
# Defaults: lax/false in development, none/true in production.
REFRESH_COOKIE_SAMESITE=
REFRESH_COOKIE_SECURE=
REFRESH_COOKIE_DOMAIN=

# ---- Seed super admin ----
SEED_SUPERADMIN_EMAIL=superadmin@offers.app
SEED_SUPERADMIN_PASSWORD=SuperAdmin@123
SEED_DEMO_DATA=true

# ---- Guest/authenticated caching (Guest Browsing §26) -----------------------
# Anonymous public-discovery responses may be cached; anything derived from a
# bearer token is always private, no-store. These tune only the public window.
CACHE_PUBLIC_MAX_AGE=60
CACHE_SHARED_MAX_AGE=300
# ---- AI service (TOY-ai-backend, Python/FastAPI) ----
# The Node API never talks to Gemini/OpenAI directly: it calls this service,
# which is the only process holding provider keys.
AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:8000
# Must match AI_SERVICE_TOKEN in TOY-ai-backend/.env
AI_SERVICE_TOKEN=change-me-ai-service-token
AI_SERVICE_TIMEOUT_MS=60000

# How much authorised merchant history the assistant may be given (§11, §38)
AI_HISTORY_OFFER_LIMIT=12
AI_HISTORY_WINDOW_DAYS=180
AI_MIN_HISTORY_OFFERS=2

# ---------------------------------------------------------------------------
# Structured logging & error tracing (Logging §6, §7, §11, §34, §35, §40)
# ---------------------------------------------------------------------------
# Logs are JSON lines on stdout, one object per event, for a shipper to collect.

# Name this service reports itself as (§6). Only worth changing if a second
# Node service ever writes into the same log stream.
LOG_SERVICE_NAME=offers-api

# DEBUG | INFO | WARN | ERROR | FATAL (§7). Defaults to `debug` outside
# production and `info` in it - §7 is explicit that verbose DEBUG must not be
# on in production by default. Raise it to `debug` temporarily to trace an
# incident, and put it back.
LOG_LEVEL=info

# Human-readable coloured output instead of JSON. On by default outside
# production; needs the `pino-pretty` devDependency, and silently falls back to
# JSON without it. Leave off wherever logs are collected.
LOG_PRETTY=false

# Deployment correlation (§40) - "did this error start after Tuesday's
# release?". Set by whatever performs the deploy; APP_VERSION falls back to
# the version in package.json.
APP_VERSION=
DEPLOYMENT_ID=

# Request duration bands (§11). Under `slow` is normal, over it is SLOW, over
# `very slow` is VERY_SLOW. Slow requests are logged at WARN and are not
# errors - they exist to be charted, not alerted on.
LOG_SLOW_REQUEST_MS=500
LOG_VERY_SLOW_REQUEST_MS=2000

# The same idea for a single database statement (§13). A query over this is
# logged with its operation label (SELECT_OFFERS) and duration - never the SQL
# text or its parameters.
LOG_SLOW_QUERY_MS=1000

# How long rows in `error_logs` are kept before the nightly prune job removes
# them (§35). Application logs: 30-90 days. Audit and payment records are
# governed separately and are NOT covered by this.
LOG_RETENTION_DAYS=90
